{
  "info": {
    "name": "PayFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "apiKey", "value": "PASTE_SEEDED_API_KEY" },
    { "key": "paymentId", "value": "PASTE_PAYMENT_ID" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{apiKey}}" },
          { "key": "Idempotency-Key", "value": "demo-key-000001" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 12500,\n  \"currency\": \"INR\",\n  \"description\": \"Demo order\",\n  \"customerReference\": \"customer-001\"\n}" },
        "url": "{{baseUrl}}/api/v1/payments"
      }
    },
    {
      "name": "List payments",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": "{{baseUrl}}/api/v1/payments"
      }
    },
    {
      "name": "Authorize payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/authorize"
      }
    },
    {
      "name": "Capture payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/capture"
      }
    },
    {
      "name": "Refund payment",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
        "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/refund"
      }
    }
  ]
}
